# Map keys for terrain and satellite imagery. You need one of them.
# If both are set, MapTiler is used. With neither, the map is flat.

# MapTiler (default): free key from https://cloud.maptiler.com/account/keys/
# Slightly lower quality than Cesium ion, but a more generous free usage allowance.
# If you restrict the key to allowed origins, include "localhost".
MAPTILER_KEY=

# Cesium ion: free token from https://ion.cesium.com/tokens
# Fine for running on your own computer; the free tier is personal/non-commercial,
# so don't use it on a publicly deployed server.
CESIUM_ION_TOKEN=
